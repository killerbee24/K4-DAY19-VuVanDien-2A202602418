# Copy to .env (never commit .env). Fill AT LEAST ONE chat key and one embedding-capable key.
# Automatic chat order: OpenAI -> OpenRouter -> Gemini -> Anthropic -> MWAPI.
# Anthropic and MWAPI are chat-only in this project, so they need OpenAI/OpenRouter/Gemini for embeddings.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MWAPI_API_KEY=

# Optional: force a provider instead of the order above
# LLM_PROVIDER=openai          # openai | openrouter | gemini | anthropic | mwapi
# EMBEDDING_PROVIDER=openai    # openai | openrouter | gemini

# Optional: override default models (<PROVIDER>_CHAT_MODEL / <PROVIDER>_EMBEDDING_MODEL)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# MWAPI (Anthropic-compatible /v1/messages). Do not add /v1 to the SDK base URL.
# LLM_PROVIDER=mwapi
# MWAPI_BASE_URL=https://api.mwapi.dev
# MWAPI_CHAT_MODEL=claude-haiku-4-5-20251001
# MWAPI_MAX_TOKENS=4096
# MWAPI_PRICE_MULTIPLIER=5

# Must match NEO4J_AUTH used in `docker run`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
